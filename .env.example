# ===== Redis (consumido por @andestec/persistencia-redis, configurado por api-dispositivos) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Identidad del dispositivo (usada por @andestec/api-dispositivos para TokenGen) =====
DISPOSITIVO_ID=
DISPOSITIVO_CLAVE=
CLAVE_PAREO=ClavePareoDisp2024

# ===== Administrador de Dispositivos (usado por @andestec/api-dispositivos) =====
ADMIN_DISP_HOST=tu-servidor-dispositivos
ADMIN_DISP_PORT=443
# IMPORTANTE: debe terminar con barra "/". El endpoint se concatena: {BASEURL}APIPareo/...
ADMIN_DISP_BASEURL=/AdministradorDispositivos/Dispositivos/WebService/
ADMIN_DISP_TIMEOUT=30
ADMIN_DISP_SECURE=1

# ===== Backend REST de Parámetros (ObtencionParametros) =====
# Base COMPLETA del servicio (sin barra final). Endpoints: {BASEURL}/GetParametrosValues, etc.
PARAM_API_BASEURL=https://tu-backend/Api/ObtencionParametros
# Timeout de las llamadas REST, en segundos.
PARAM_API_TIMEOUT=30

# ===== Contexto por defecto de la aplicación =====
# Aplicacion_Idl por defecto (se puede sobrescribir por llamada).
PARAM_APLICACION_ID=
# Modo por defecto ("", "WebApp", "CMD", ...). Participa en el strControl del token.
PARAM_MODO=
# Vigencia de los valores cacheados en Redis, en milisegundos (default 5 min).
PARAM_VIGENCIA_MS=300000

# ===== Circuit-breaker offline =====
# Segundos que un servicio queda "offline" tras un error de red (default 300).
PARAM_BREAKER_NET_S=300
# Segundos de throttle entre re-descargas de definiciones/estructuras (default 180; 0 = sin throttle).
PARAM_DEF_THROTTLE_S=180
